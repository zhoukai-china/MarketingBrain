# BY-49 private OSS staging; storage selection does NOT enable paid video execution.
# Only a separately authorized isolated account/bucket may be configured. Never use DashScope keys here.
BEAUTY_VIDEO_STAGING_DRIVER=disabled
BEAUTY_VIDEO_EXECUTION_MODE=disabled
# Server-only signing authority, NOT a Provider key. Configuration alone does not issue a permit.
BEAUTY_VIDEO_EXECUTION_AUTHORITY_KEY=
BEAUTY_VIDEO_RESULT_HOSTS=
# BY54: server-only Seedance configuration; empty keys + 0 unapproved credit quote keep it disabled.
# No public route issues permits/reviews; do not reuse wan scopes or upload real assets for setup.
SEEDANCE_EXECUTION_MODE=disabled
ARK_API_KEY=
SEEDANCE_EXECUTION_AUTHORITY_KEY=
SEEDANCE_REVIEW_AUTHORITY_KEY=
