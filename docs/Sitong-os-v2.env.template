# Copy this file to /etc/Sitong-secrets/Sitong-os-v2.env on the Aliyun ECS.
# Do not commit the filled production file.

NODE_ENV=production
PORT=3002
DATA_MODE=database
CONTINUOUS_IMPROVEMENT_ENABLED=false
CONTINUOUS_IMPROVEMENT_AUTO_PERSIST=false
CONTINUOUS_IMPROVEMENT_AUTO_ACTIVATE=false
CONTINUOUS_IMPROVEMENT_MIN_SAMPLE=10

# Aliyun RDS PostgreSQL, v2 dedicated database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sitong_os_v2

# China domestic top-tier models only. Do not use OpenAI/Anthropic/Gemini/overseas nodes.
LLM_PROVIDER=deepseek
LLM_ALLOWED_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL=qwen-max
ALIYUN_VIDEO_MODEL=qwen-vl-max
ALIYUN_ASR_MODEL=qwen3-asr-flash
ALIYUN_MEDIA_BASE64_MAX_MB=12
# 公共平台语音输入（PLAT-33）：不配就用默认值（10MB / 60 次每小时 / 60 秒超时）
VOICE_TRANSCRIBE_MAX_MB=10
VOICE_TRANSCRIBE_HOURLY_LIMIT=60
VOICE_TRANSCRIBE_TIMEOUT_MS=60000
DOMESTIC_COMPATIBLE_PROVIDER_NAME=domestic-compatible
DOMESTIC_COMPATIBLE_API_KEY=
DOMESTIC_COMPATIBLE_BASE_URL=
DOMESTIC_COMPATIBLE_MODEL=deepseek-v4-pro
LLM_TIMEOUT_MS=45000

# Original Skill MCP. Keep original SKILL.md files under ORIGINAL_SKILL_ROOT;
# Sitong AI loads them through /mcp instead of copying skill text into business code.
SKILL_MCP_URL=http://127.0.0.1:3002/mcp
SKILL_MCP_TOKEN=
SKILL_MCP_REQUIRED=true
SKILL_MCP_INVOKE_TIMEOUT_MS=420000
ORIGINAL_SKILL_ROOT=/opt/Sitong-os-v2/mcp-skills/skills

# Generate with: pnpm secrets:generate
JWT_SECRET=
KNOWLEDGE_CREDENTIALS_KEY=
ADMIN_TOKEN=
OPS_TOKEN=

# Beta gate. Prefer database invite codes; keep INVITE_CODES empty unless emergency fallback is needed.
INVITE_REQUIRED=true
INVITE_CODES=

# China-only outbound policy.
DOMESTIC_NETWORK_ONLY=true
DOMESTIC_OUTBOUND_ALLOWLIST=api.deepseek.com,dashscope.aliyuncs.com,bailian.aliyuncs.com,openapi.biji.com,api.weixin.qq.com,api.mch.weixin.qq.com,api.lcppch.top,www.jiqizhixin.com,www.leiphone.com,www.tmtpost.com,nls-meta.cn-shanghai.aliyuncs.com,nls-gateway-cn-shanghai.aliyuncs.com

# WeChat OAuth. First beta can use invite-only login; set true after official OAuth materials are ready.
WECHAT_AUTH_REQUIRED=false
WECHAT_AUTH_APPID=
WECHAT_AUTH_SECRET=
WECHAT_AUTH_REDIRECT_URI=https://api.lcppch.top/os-v2/wechat-callback

# WeChat Pay. First beta can use manual payment/opening. Set true after official WeChat Pay materials are ready.
WECHAT_PAY_REQUIRED=false
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_FILE=
WECHAT_PAY_NOTIFY_URL=https://api.lcppch.top/os-v2/api/billing/wechat/notify
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_FILE=

# Local server storage. Use Aliyun OSS later when file volume grows.
UPLOAD_DIR=/opt/Sitong-os-v2/uploads

# Web build.
VITE_API_BASE_URL=https://api.lcppch.top/os-v2/api
VITE_BASE_PATH=/os-v2/
VITE_WECHAT_AUTH_APPID=
VITE_WECHAT_AUTH_REDIRECT_URI=https://api.lcppch.top/os-v2/wechat-callback
