.cv-title span{font-size:11px;color:var(--sub)}
.cv-slogan{margin-top:3px;font-size:11.5px;color:var(--sub);line-height:1.5}
.cv-slogan b{color:var(--orange)}
.cv-chips{display:flex;gap:7px;overflow-x:auto;padding:10px 0 11px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.cv-chips::-webkit-scrollbar{display:none}
.cv-chip{flex:none;padding:6px 14px;border-radius:999px;font-size:12px;font-weight:700;color:var(--sub);
  border:1px solid var(--line2);background:#FFFDF9;transition:all .18s}
