  if(coachIdx >= 0){
    var pc = coachStepCourse(coachIdx), nc = coachStepCourse(i);
    if(pc > 0 && pc !== nc && i > coachIdx) coachMarkDone(pc);
  }
  coachIdx = i;
  var step = COACH_STEPS[i];
