  -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
.case-gain{position:absolute;right:12px;bottom:9px;text-align:right;pointer-events:none}
.case-gain b{display:block;font-size:24px;font-weight:900;color:#fff;line-height:1.1;
  text-shadow:0 2px 12px rgba(0,0,0,.4),0 0 26px rgba(0,0,0,.25)}
