var CART_ITEMS = [];
function addToCart(it){
  var found = null;
  CART_ITEMS.forEach(function(x){ if(x.key === it.key) found = x; });
  if(found) found.qty++;
  else CART_ITEMS.push(Object.assign({ qty:1 }, it));
  renderCart();
  toast("🛒 " + it.name + " 已加入购物车", 2200);
}
function renderCart(){
  var list = $("#cartList"), html = "", tc = 0, ty = 0, count = 0;
  var paybar = $("#cartPaybar");
  if(paybar) paybar.style.display = CART_ITEMS.length ? "flex" : "none";
  if(!CART_ITEMS.length){
    list.innerHTML = '<div class="cart-empty"><span class="ce-ico">🛒</span><b>购物车还是空的</b><br><span style="font-size:11px">在商城里点「🛒 加购」，把看好的课程 / 硬件 / 额度包加进来（智能体不用加购，0 元开通直接用）</span><br><button class="ghost-btn" id="cartGoMall" style="margin-top:16px;min-height:40px">去商城逛逛 ›</button></div>';
    var gm = $("#cartGoMall");
    if(gm) gm.addEventListener("click", function(){ switchTab("home", $('.tab[data-tab="home"]')); });
  } else {
    CART_ITEMS.forEach(function(it, i){
      var cny = it.cur === "cny";
      if(cny) ty += it.ppu * it.qty; else tc += it.ppu * it.qty;
      count += it.qty;
      var pic = "";
      if(AVATARS[it.key]) pic = '<img class="ci-ava" src="' + AVATARS[it.key] + '" alt="">';
      else if(IMG_ASSETS[it.img]) pic = '<img class="ci-ava" src="data:image/jpeg;base64,' + IMG_ASSETS[it.img] + '" alt="">';
      else pic = '<span class="ci-ava" style="display:grid;place-items:center;background:rgba(255,122,26,.12);font-size:20px">🛍️</span>';
      var priceTxt = cny ? '¥' + fmt(it.ppu) + (it.per || "") + ' · 人民币直购' : '⚡ ' + fmt(it.ppu) + ' 算力' + (it.per || "");
      html += '<div class="cart-item">' + pic +
        '<div class="ci-main"><b>' + it.name + '</b><span>' + it.unit + ' · ' + priceTxt + '</span></div>' +
        '<div class="ci-step"><button data-cdec="' + i + '">−</button><b>' + it.qty + '</b><button data-cinc="' + i + '">+</button></div></div>';
    });
    list.innerHTML = html;
  }
  var sp = $("#cartSuanPart");
  if(sp) sp.style.display = tc > 0 ? "" : "none"; /* 纯人民币商品时隐藏算力轨，不显示「合计 0 算力」噪音 */
  $("#cartTotal").textContent = fmt(tc);
  $("#cartComputeCny").textContent = "≈ ¥" + fmt(tc / 10);
  var cy = $("#cartCnyTotal");
  cy.style.display = ty > 0 ? "" : "none";
  cy.textContent = (tc > 0 ? "+ ¥" : "¥") + fmt(ty) + " 直购";
  $("#cartCount").textContent = count + " 件商品";
  var badge = $("#tabCartBadge");
  if(badge){ badge.textContent = count; badge.style.display = count ? "inline-flex" : "none"; }
  $$("[data-cinc]", list).forEach(function(b){ b.addEventListener("click", function(){ CART_ITEMS[+b.getAttribute("data-cinc")].qty++; renderCart(); }); });
  $$("[data-cdec]", list).forEach(function(b){ b.addEventListener("click", function(){
    var i = +b.getAttribute("data-cdec");
    if(CART_ITEMS[i].qty > 1) CART_ITEMS[i].qty--; else CART_ITEMS.splice(i, 1);
    renderCart();
  }); });
}
