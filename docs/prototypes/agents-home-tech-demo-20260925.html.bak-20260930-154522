.case-body{padding:12px 14px 14px}
.case-title{font-size:15.5px;font-weight:800;line-height:1.45}
.case-sub{margin-top:4px;font-size:11px;color:var(--sub)}
.case-metrics{display:flex;gap:8px;margin-top:10px}
.case-metric{flex:1;background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:8px 10px;min-width:0}
.case-metric .k{font-size:10px;color:var(--dim);white-space:nowrap}
.case-metric .v{margin-top:2px;font-size:11.5px;color:#BEA488;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.case-metric .v b{color:var(--green);font-size:13px;margin-left:4px}
.case-inspire{margin-top:10px;padding:9px 11px;border-radius:12px;background:rgba(255,106,0,.06);
  border:1px dashed rgba(255,122,26,.35);font-size:12px;color:#7A5A3A;line-height:1.55}
.case-inspire b{color:var(--orange)}
.case-cta{display:flex;gap:8px;margin-top:12px;align-items:stretch}
.case-use{flex:1;min-height:42px;border-radius:13px;font-size:13.5px;font-weight:800;color:#fff;
  background:linear-gradient(135deg,var(--orange),var(--orange2));box-shadow:0 6px 18px rgba(242,83,0,.28);
  display:flex;align-items:center;justify-content:center;gap:6px}
.case-use:active{transform:scale(.97)}
.case-more{min-height:42px;padding:0 14px;border-radius:13px;font-size:12.5px;color:var(--sub);font-weight:700;
  border:1px solid var(--line2);background:#FFF9F2;display:flex;align-items:center;white-space:nowrap}
.cv-loading{display:none;text-align:center;padding:14px 0 4px;color:var(--dim);font-size:12px}
.cv-loading.show{display:block}
.cv-loading i{display:inline-block;width:15px;height:15px;border:2px solid var(--orangeSoft);border-top-color:var(--orange);
  border-radius:50%;animation:cvSpin .7s linear infinite;vertical-align:-3px;margin-right:7px}
@keyframes cvSpin{to{transform:rotate(360deg)}}
.cv-end{display:none;text-align:center;padding:18px 0 6px;color:var(--dim);font-size:12px;line-height:2}
.cv-end.show{display:block}
.cv-end button{color:var(--orange);font-weight:800;font-size:13px;padding:4px 8px}
/* 案例详情弹层 */
