/* 伪二维码：确定性 pattern（演示用，无真实跳转） */
(function(){
  var qr = document.getElementById("invQr");
  if(!qr) return;
  var seed = 0, s = "ST-A8C3X2";
  for(var k = 0; k < s.length; k++) seed = (seed * 31 + s.charCodeAt(k)) % 2147483647;
  function rnd(){ seed = (seed * 48271) % 2147483647; return seed / 2147483647; }
  var html = "";
  for(var r = 0; r < 21; r++){
    for(var c = 0; c < 21; c++){
      var corner = (r < 7 && c < 7) || (r < 7 && c > 13) || (r > 13 && c < 7);
      var fill;
      if(corner){
        var rr = r >= 14 ? r - 14 : r, cc = c >= 14 ? c - 14 : c;
        var inRing = rr === 0 || rr === 6 || cc === 0 || cc === 6;
        var inCore = rr >= 2 && rr <= 4 && cc >= 2 && cc <= 4;
        fill = inRing || inCore;
      } else {
        fill = rnd() > 0.52;
      }
      html += fill ? '<i class="f"></i>' : '<i></i>';
    }
  }
  qr.innerHTML = html;
})();
