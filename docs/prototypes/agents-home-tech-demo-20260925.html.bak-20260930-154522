  box-shadow:0 6px 24px rgba(160,90,20,.07);animation:cvCard .45s both;cursor:pointer}
@keyframes cvCard{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
.case-card:active{transform:scale(.99)}
.case-cover{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,#FFE3C8,#FFD2A8)}
.case-cover img{width:100%;height:100%;object-fit:cover;display:block}
.case-tag{position:absolute;top:10px;left:10px;padding:3px 10px;border-radius:999px;
