function tongSendMsg(){
  var inp = $("#tongInput"), v = inp.value.trim();
  if(!v){ toast("先输入你想问小潼的问题"); return; }
  $("#tongChips").style.display = "none";
  inp.value = "";
  var zone = $("#tongChat");
  var inputRow = zone.querySelector(".chat-input");
  /* 用户消息行：追加到对话区末尾（输入框上方），保证「提问在上、回答在下」 */
  var urow = document.createElement("div");
  urow.className = "me-bubble";
  urow.style.display = "flex";
  var ub = document.createElement("span");
  ub.className = "bubble";
  ub.textContent = v;
  var ua = document.createElement("span");
  ua.className = "chat-ava";
  ua.style.cssText = "background:rgba(255,122,26,.15);border-color:rgba(255,122,26,.4)";
  ua.textContent = "🙋";
  urow.appendChild(ub); urow.appendChild(ua);
  zone.insertBefore(urow, inputRow);
  urow.scrollIntoView({ behavior: "smooth", block: "nearest" });
  setTimeout(function(){
    var row = document.createElement("div");
    row.className = "chat-row";
    row.style.marginTop = "10px";
    row.innerHTML = '<span class="chat-ava">🤖</span><span class="bubble"></span>';
    zone.insertBefore(row, urow.nextSibling); /* 回复插在用户消息下面 */
    var bb = row.querySelector(".bubble");
    var rep = tongReply(v);
    typewriter(bb, rep.t, 20, function(){
      if(rep.act){
        var ab = document.createElement("button");
        ab.type = "button"; ab.className = "chat-go"; ab.textContent = rep.act.label;
        ab.addEventListener("click", function(){ tongActGo(rep.act); });
        var wrap = document.createElement("div");
        wrap.style.margin = "7px 0 0 34px";
        wrap.appendChild(ab);
        zone.insertBefore(wrap, row.nextSibling);
      }
      var chips = $("#tongChips");
      zone.insertBefore(chips, inputRow); /* 快捷问题始终压到输入框上方 */
      chips.style.display = "flex";
      row.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  }, 420);
}
$("#tongSend").addEventListener("click", tongSendMsg);
$("#tongInput").addEventListener("keydown", function(ev){ if(ev.key === "Enter") tongSendMsg(); });
$("#tongBtn").addEventListener("click", function(){
  if(DEMO.on) stopDemo();
  tongOpen();
});

