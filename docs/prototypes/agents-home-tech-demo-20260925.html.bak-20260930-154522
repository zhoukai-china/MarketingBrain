var toastTimer = null;
function toast(msg, ms){
  var t = $("#toast");
  t.innerHTML = msg;
  t.classList.add("show");
  if(toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){ t.classList.remove("show"); }, ms || 2600);
}

function typewriter(el, html, speed, cb){
  /* 定时器挂在元素上：同元素重启才互斥，不同元素互不干扰（否则聊天回复的完成回调会被别的打字动画误杀） */
  if(el._twTimer) clearTimeout(el._twTimer);
  el.innerHTML = "";
  var caret = document.createElement("span");
  caret.className = "caret"; el.appendChild(caret);
  var tmp = document.createElement("div"); tmp.innerHTML = html;
  var text = tmp.textContent || "";
  var i = 0;
  var tick = function(){
    if(i >= text.length){ el._twTimer = null; if(cb) cb(); return; }
    caret.insertAdjacentText("beforebegin", text.charAt(i));
    i++;
    el._twTimer = setTimeout(tick, speed || 26);
  };
  tick();
}

function tweenNum(el, from, to, ms){
  var t0 = Date.now();
  var step = function(){
    var p = Math.min(1, (Date.now() - t0) / (ms || 800));
    var eased = 1 - Math.pow(1 - p, 3);
    el.textContent = fmt(from + (to - from) * eased);
    if(p < 1) requestAnimationFrame(step);
  };
  step();
  /* 兜底：rAF 被节流（后台标签页）时也要收敛到终值 */
  setTimeout(function(){ el.textContent = fmt(to); }, (ms || 800) + 60);
}

/* ================= 背景：神经网络粒子 ================= */
(function(){
  var cv = $("#bg-net"), ctx = cv.getContext("2d");
  var W, H, pts = [], N;
  function size(){
    W = cv.width = window.innerWidth;
    H = cv.height = window.innerHeight;
    N = W < 640 ? 22 : 40;
    pts = [];
    for(var i = 0; i < N; i++){
      pts.push({ x: Math.random() * W, y: Math.random() * H,
        vx: (Math.random() - .5) * .28, vy: (Math.random() - .5) * .28,
        r: Math.random() * 1.6 + .6,
        c: Math.random() < .28 ? "255,140,60" : "245,176,74" });
    }
  }
  size(); window.addEventListener("resize", size);
  (function loop(){
    ctx.clearRect(0, 0, W, H);
    for(var i = 0; i < pts.length; i++){
      var p = pts[i];
      p.x += p.vx; p.y += p.vy;
      if(p.x < 0 || p.x > W) p.vx *= -1;
      if(p.y < 0 || p.y > H) p.vy *= -1;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.283);
      ctx.fillStyle = "rgba(" + p.c + ",.55)"; ctx.fill();
      for(var j = i + 1; j < pts.length; j++){
        var q = pts[j], dx = p.x - q.x, dy = p.y - q.y, d2 = dx * dx + dy * dy;
        if(d2 < 16900){
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y);
          ctx.strokeStyle = "rgba(255,140,50," + (.16 * (1 - d2 / 16900)) + ")";
          ctx.lineWidth = 1; ctx.stroke();
        }
      }
    }
    requestAnimationFrame(loop);
  })();
})();

