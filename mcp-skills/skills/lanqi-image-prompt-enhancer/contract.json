  "scope": "lanqi_text_to_image_prompt_enhancement_only",
  "qualityBar": "structured_model_ready_prompt",
  "minLength": 900,
  "scoreThreshold": 90,
  "requiredSections": ["intentUnderstanding", "missingQuestions", "directions", "revisionSummary", "knowledgeStatus", "factBoundary"],
