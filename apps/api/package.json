{
  "name": "@baolu/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --exclude uploads/** --exclude src/routes/exports.ts --exclude src/routes/tenant.ts --exclude src/services/agent-runtime.ts --exclude ../../packages/agent/** src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-data.mjs",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@baolu/agent": "workspace:*",
    "@baolu/db": "workspace:*",
    "@baolu/shared": "workspace:*",
    "@baolu/skills": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@napi-rs/canvas": "^0.1.80",
    "ali-oss": "6.23.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pngjs": "^5.0.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.16.2"
  }
}
