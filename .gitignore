node_modules
/.pnpm-store/
dist
.env
.env.*
!.env.example
uploads
*.log
reports/continuous-improvement/
.DS_Store

# Local deployment packages, runtime state, and generated QA artefacts
/.codex/
/.deploy/
/release/
/.qa/
/.codex-runtime/
/.esbuild-repair/
/.codex-*.tar.gz
/.codex-*.tgz
/.tmp-*
/_tmp_*/

# 本地发布包与本地暂存目录：体积大、可重建，永不入库
/.tmp/
/release-*.tar.gz

# One-off local deployment and diagnostic outputs
/deploy/
/deploy-package/
/deploy_probe.txt
node_modules.broken-*
/online-index-*.js
/online-index-*.css
/esbuild-*.tgz
/takeaway-format-*.tgz
/test-leads.csv

# Local debug artefacts (browser shots, dev logs). Never part of the release archive.
/.debug/

# scripts/tmp/ 里是发布与验收用的脚本（build-prod-filelist / deploy-release /
# prod-*-readonly-check 等），文档按这个路径引用它们，因此纳入版本管理；
# 该目录仍被 scripts/tmp/build-prod-filelist.ps1 的 excludePattern 排除，
# 不随发布包上线。目录内的截图 / 日志 / json 产物按下面的规则单独忽略。
/scripts/tmp/**/*.png
/scripts/tmp/**/*.json
/scripts/tmp/**/*.log
# scripts/tmp 下新增的一次性产物（filelist / 探针 / stage 目录 / 归档 / hash 文本）默认不入库；
# 已跟踪的部署脚本（deploy-release.sh、verify-deploy.sh 等）不受影响，仍保持跟踪。
/scripts/tmp/*

# Historical reports and local working drafts are not source of truth
/reports/
/apps/api/reports/
/work/
/_tmp_*
/logs/

# avatars 下的临时 / 候选草稿（下划线前缀，非正式资源，勿入库）
/apps/web/public/avatars/_*
