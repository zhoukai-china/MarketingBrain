# 保禄AI增长OS · 通用点数计费后端环境变量示例
# 复制为 .env 并按需修改

# 服务
HOST=127.0.0.1
PORT=3007
DEBUG=false

# 数据库（SQLite 单文件）
DATABASE_URL=sqlite:///./billing.db

# 安全（空则不启用管理接口）
ADMIN_TOKEN=

# 计费
TRIAL_POINTS=0
WELCOME_POINTS=0
TASK_COST_POINTS=5

# 古人经营智慧（六顾问 chat）：0=免费体验期；按次计费改 10-30（10 积分=1 元）
GU_POINTS_PER_CALL=0
GU_DAILY_FREE_CALLS=10
GU_CONV_TTL_HOURS=6
GU_MAX_CONTEXT_MESSAGES=16
GU_TIMEOUT=90
GU_MAX_MESSAGE_CHARS=500

# 微信支付
WECHAT_PAY_MOCK=true
WECHAT_PAY_MCHID=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_APPID=
WECHAT_PAY_NOTIFY_URL=https://api.lcppch.top/os-v2/api/skills/recharge/notify
WECHAT_PAY_DESCRIPTION=思潼AI增长OS-通用点数充值

# CORS
CORS_ORIGINS=*
