generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCode {
  local_standard
  local_premium
  chain_standard
  chain_premium
  ip_standard
  ip_premium
}

enum TenantType {
  local_business
  chain_brand
  personal_ip
}

enum SubscriptionStatus {
  trialing
  active
  expired
  canceled
}

enum MembershipRole {
  owner
  admin
  operator
  manager
  staff

  @@map("UserRole")
}

enum SkillRunStatus {
  pending
  succeeded
  needs_input
  failed
}

enum CreditDirection {
  grant
  consume
  refund
  adjust
}

enum BillingOrderType {
  subscription
  credit_pack
  project_package
  agent_offer
}

enum AgentStatus {
  draft
  active
  coming_soon
  archived
}

enum AgentEntitlementStatus {
  active
  paused
  expired
  revoked
}

enum LanqiKnowledgeTier {
  k1_authorized_core
  k2_headquarters_private
  k3_store_private
  k4_session_temporary
}

enum LanqiKnowledgeStatus {
  draft
  active
  retired
}

enum LanqiReferralStatus {
  pending
  claimed
  revoked
}

enum AgentOfferStatus {
  draft
  active
  archived
}

enum SkillReleaseStatus {
  draft
  active
  retired
}

enum AnonymousTrialStatus {
  available
  used
  claimed
}

enum BillingOrderStatus {
  pending
  paid
  canceled
  expired
  refunded
}

enum AutomationTaskType {
  daily_business_advice
  weekly_topic_push
  moments_push
  inactive_user_wakeup
  profile_completion
  subscription_expiry
  file_analysis_followup
  audio_card_analysis
  local_push_ad_plan
  local_push_ad_adjustment
  video_publish_plan
  video_publish_execution
  ceo_action_order
  beauty_daily_brief
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  type      TenantType
  industry  String?
  city      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  stores                    Store[]
  memberships               Membership[]
  profile                   TenantProfile?
  subscriptions             Subscription[]
  creditAccount             CreditAccount?
  conversations             Conversation[]
  files                     UploadedFile[]
  agentRuns                 AgentRun[]
  agentOutcomeEvents        AgentOutcomeEvent[]
  automationTasks           AutomationTask[]
  beautyDailyBriefSnapshots BeautyDailyBriefSnapshot[]
  desktopDevices            DesktopDevice[]
  billingOrders             BillingOrder[]
  offlineEvents             OfflineEvent[]
  viralVideoReplicationJobs ViralVideoReplicationJob[]
  growthCohorts             GrowthProjectCohort[]
  growthProjects            GrowthProject[]
  distributors              Distributor[]
  commissionRules           CommissionRule[]
  riskRules                 RiskRule[]
  riskEvents                RiskEvent[]
  auditLogs                 AuditLog[]
  roles                     Role[]
  accessPolicies            AccessPolicy[]
  ssoConfigs                SsoConfig[]
  shareLinks                ShareLink[]
  agentEntitlements         TenantAgentEntitlement[]
  anonymousTrials           AnonymousTrial[]
  knowledgeConnections      KnowledgeConnection[]
  knowledgeDocuments        KnowledgeDocument[]
  knowledgeSyncJobs         KnowledgeSyncJob[]
  knowledgeSubjects         KnowledgeSubject[]
  founderIpGoalBriefs       FounderIpGoalBrief[]
  knowledgeAnalyses         KnowledgeAnalysisBatch[]
  lanqiKnowledgeVersions    LanqiKnowledgeVersion[]
  lanqiReferralsSent        LanqiReferral[]            @relation("LanqiReferralInviter")
  lanqiReferralReceived     LanqiReferral[]            @relation("LanqiReferralReferred")
  lanqiStoreProfile         LanqiStoreProfile?
  lanqiContentDrafts        LanqiContentDraft[]
  lanqiMediaJobs            LanqiMediaJob[]
  lanqiStoreGoals           LanqiStoreGoal[]
  customDomain              TenantDomain?
  workbuddyConnections      WorkbuddyMcpConnection[]
  takeawayDataImports       TakeawayDataImport[]
  productEntitlements       TenantProductEntitlement[]
  beautyVideoAssetAuthorizations BeautyVideoAssetAuthorization[]
  billingAccessTokens       BillingAccessToken[]
  billingConsumes           BillingConsume[]
}

model TenantProductEntitlement {
  id          String    @id @default(cuid())
  tenantId    String
  productCode String
  status      String    @default("active")
  source      String
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productCode])
  @@index([productCode, status, expiresAt])
}

model LanqiStoreProfile {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  confirmedFacts Json
  estimatedFacts Json
  needsInput     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// 兰琪驾驶舱唯一的「手输」数据：本月 4 个目标（业绩/新客/升单/唤醒）。
/// 口径：按 store_id + month 各存一条，一月一条、不覆盖历史；其余指标一律自动统计。
model LanqiStoreGoal {
  id         String   @id @default(cuid())
  tenantId   String
  storeId    String
  // YYYY-MM，按门店+月份唯一，改当月只更新当月这条，历史月份记录不动
  month      String
  rev        Int?
  newCount   Int?
  up         Int?
  wake       Int?
  requestKey String?
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, storeId, month])
  @@index([tenantId, month])
}

model LanqiContentDraft {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  platform    String
  goal        String
  audience    String
  topic       String
  storeFacts  Json
  copyDraft   Json
  imagePrompt String
  videoPrompt String
  sourceMode  String   @default("store_facts_only")
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model LanqiMediaJob {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String?
  requestKey      String
  kind            String
  provider        String    @default("aliyun_bailian")
  model           String
  previewId       String?
  promptVersion   String    @default("unknown")
  prompt          String
  negativePrompt  String?
  parameters      Json?
  imageUrl        String?
  resolution      String?
  ratio           String?
  durationSeconds Int?
  creditCost      Int
  status          String    @default("queued")
  billingStatus   String    @default("reserved")
  providerTaskId  String?   @unique
  providerStatus  String?
  outputUrl       String?
  assetStatus     String    @default("pending")
  selectedAt      DateTime?
  savedAt         DateTime?
  canceledAt      DateTime?
  errorMessage    String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, requestKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, previewId, createdAt])
}

model TenantDomain {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  hostname          String    @unique
  status            String    @default("pending")
  verificationToken String    @unique
  lastCheckedAt     DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Store {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  city      String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  beautyVideoAssetAuthorizations BeautyVideoAssetAuthorization[]

  @@index([tenantId])
}

model User {
  id            String   @id @default(cuid())
  nickname      String?
  avatarUrl     String?
  phone         String?
  wechatOpenid  String?  @unique
  wechatUnionid String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships          Membership[]
  messages             Message[]
  creditTxs            CreditTransaction[]
  agentRuns            AgentRun[]
  qualityFeedbacks     QualityFeedback[]
  agentOutcomeEvents   AgentOutcomeEvent[]
  desktopDevices       DesktopDevice[]
  billingOrders        BillingOrder[]
  eventRegistrations   OfflineEventRegistration[]
  growthProjects       GrowthProject[]
  distributors         Distributor[]
  riskEvents           RiskEvent[]
  auditLogs            AuditLog[]
  userRoles            UserRole[]
  anonymousTrials      AnonymousTrial[]
  knowledgeConnections KnowledgeConnection[]
  knowledgeAnalyses    KnowledgeAnalysisBatch[]
  workbuddyConnections WorkbuddyMcpConnection[]
  billingAccessTokens  BillingAccessToken[]
  wallet               Wallet?
  walletLedgers        WalletLedger[]
  rechargeOrders       RechargeOrder[]
  referralCodes             ReferralCode[]      @relation("ReferralCodeOwner")
  referralBindingsAsReferrer ReferralBinding[]  @relation("ReferralReferrer")
  referralBindingAsReferred  ReferralBinding?   @relation("ReferralReferred")

  @@index([wechatUnionid])
  @@index([phone])
}

model InviteCode {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  codePreview String
  label       String?
  planCode    PlanCode?
  productCode String?
  brandCode   String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdBy   String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  redemptions   InviteCodeRedemption[]
  lanqiReferral LanqiReferral?

  @@index([isActive, expiresAt])
  @@index([planCode])
  @@index([productCode])
  @@index([brandCode])
}

model InviteCodeRedemption {
  id           String    @id @default(cuid())
  inviteCodeId String
  tenantId     String?
  userId       String?
  planCode     PlanCode?
  usedAt       DateTime  @default(now())
  metadata     Json?

  inviteCode InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  @@index([inviteCodeId, usedAt])
  @@index([tenantId])
  @@index([userId])
}

model LanqiReferral {
  id               String              @id @default(cuid())
  inviterTenantId  String
  inviteCodeId     String              @unique
  referredTenantId String?             @unique
  status           LanqiReferralStatus @default(pending)
  label            String?
  createdAt        DateTime            @default(now())
  claimedAt        DateTime?
  revokedAt        DateTime?
  updatedAt        DateTime            @updatedAt

  inviterTenant  Tenant     @relation("LanqiReferralInviter", fields: [inviterTenantId], references: [id], onDelete: Cascade)
  inviteCode     InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  referredTenant Tenant?    @relation("LanqiReferralReferred", fields: [referredTenantId], references: [id], onDelete: SetNull)

  @@index([inviterTenantId, status, createdAt])
}

model BillingOrder {
  id                 String             @id @default(cuid())
  tenantId           String
  userId             String?
  type               BillingOrderType
  status             BillingOrderStatus @default(pending)
  planCode           PlanCode?
  billingPeriod      String?
  creditPackCode     String?
  projectPackageCode String?
  offerId            String?
  channelId          String?
  eventId            String?
  commissionRate     Decimal?           @db.Decimal(10, 4)
  credits            Int                @default(0)
  amountCny          Int                @default(0)
  provider           String             @default("wechat_pay")
  providerOrderId    String?
  codeUrl            String?
  paidAt             DateTime?
  expiresAt          DateTime
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?                    @relation(fields: [userId], references: [id])
  event             OfflineEvent?            @relation(fields: [eventId], references: [id])
  offer             AgentOffer?              @relation(fields: [offerId], references: [id])
  agentEntitlements TenantAgentEntitlement[]
  growthProjects    GrowthProject[]

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([providerOrderId])
  @@index([eventId])
  @@index([channelId])
  @@index([projectPackageCode])
  @@index([offerId])
}

model DesktopDevice {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String?
  deviceName      String
  platform        String
  appVersion      String?
  deviceTokenHash String   @unique
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?            @relation(fields: [userId], references: [id])
  tasks  AutomationTask[]

  @@index([tenantId, lastSeenAt])
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  storeId   String?
  role      MembershipRole
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  store       Store?              @relation(fields: [storeId], references: [id])
  agentAccess MemberAgentAccess[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([storeId])
}

model TenantProfile {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  data          Json
  confirmedData Json?
  inferredData  Json?
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String
  planCode  PlanCode
  status    SubscriptionStatus @default(active)
  startDate DateTime           @default(now()) @map("startsAt")
  endDate   DateTime           @map("expiresAt")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([endDate])
}

model CreditAccount {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
  reservations CreditReservation[]
}

model CreditTransaction {
  id                String          @id @default(cuid())
  creditAccountId   String
  tenantId          String
  userId            String?
  direction         CreditDirection
  amount            Int
  reason            String
  refType           String?
  refId             String?
  productCode       String?
  operatingEntityId String?
  channel           String?
  capabilityId      String?
  mcpCredentialId   String?
  provider          String?
  createdAt         DateTime        @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([tenantId, productCode, channel, createdAt])
  @@index([mcpCredentialId, createdAt])
}

model CreditReservation {
  id                 String   @id @default(cuid())
  creditAccountId    String
  tenantId           String
  userId             String?
  productCode        String?
  operatingEntityId  String?
  channel            String
  mcpCredentialId    String?
  requestId          String   @unique
  requestFingerprint String?
  amount             Int
  actualAmount       Int?
  status             String   @default("reserved")
  agentRunId         String?
  errorCode          String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, productCode, status, createdAt])
  @@index([mcpCredentialId, status, createdAt])
}

model Conversation {
  id          String   @id @default(cuid())
  tenantId    String
  title       String?
  channel     String
  deviceScope String   @default("desktop")
  agentId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages  Message[]
  agentRuns AgentRun[]
  agent     AgentDefinition? @relation(fields: [agentId], references: [id])

  @@index([tenantId, updatedAt])
  @@index([tenantId, agentId, updatedAt])
  @@index([tenantId, agentId, deviceScope, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  tenantId       String
  userId         String?
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([conversationId, createdAt])
}

model AgentRun {
  id                 String         @id @default(cuid())
  tenantId           String
  userId             String?
  conversationId     String?
  agentId            String?
  capabilityId       String?
  requestId          String?        @unique
  requestFingerprint String?
  mcpCallId          String?        @unique
  routingSource      String?
  deviceScope        String         @default("desktop")
  skillId            String
  skillVersion       String
  tenantType         TenantType
  status             SkillRunStatus
  input              String
  output             String?
  qualityFlags       Json?
  modelProvider      String
  productCode        String?
  operatingEntityId  String?
  usageChannel       String?
  mcpCredentialId    String?
  tokenEstimate      Int            @default(0)
  creditCost         Int            @default(0)
  errorMessage       String?
  createdAt          DateTime       @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id])
  conversation Conversation?    @relation(fields: [conversationId], references: [id])
  agent        AgentDefinition? @relation(fields: [agentId], references: [id])

  feedback         QualityFeedback[]
  steps            AgentRunStep[]
  outcomeEvents    AgentOutcomeEvent[]
  qualityReview    AgentQualityReview?
  learnedEvalCases LearnedEvalCase[]

  @@index([tenantId, createdAt])
  @@index([skillId, createdAt])
  @@index([agentId, createdAt])
  @@index([tenantId, deviceScope, createdAt])
  @@index([tenantId, productCode, usageChannel, createdAt])
  @@index([mcpCredentialId, createdAt])
}

model AgentRunStep {
  id           String         @id @default(cuid())
  agentRunId   String
  stepId       String
  sortOrder    Int            @default(0)
  capabilityId String?
  skillId      String
  skillVersion String
  status       SkillRunStatus
  dependsOn    Json?
  input        String
  output       String?
  qualityFlags Json?
  creditCost   Int            @default(0)
  durationMs   Int            @default(0)
  errorCode    String?
  createdAt    DateTime       @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, stepId])
  @@index([skillId, createdAt])
  @@index([status, createdAt])
}

model AgentDefinition {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String?
  status      AgentStatus @default(draft)
  sortOrder   Int         @default(0)
  marketing   Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  capabilities         AgentCapability[]
  skillBindings        AgentSkillBinding[]
  entitlements         TenantAgentEntitlement[]
  memberAccess         MemberAgentAccess[]
  offerAgents          AgentOfferAgent[]
  trials               AnonymousTrial[]
  conversations        Conversation[]
  agentRuns            AgentRun[]
  workbuddyConnections WorkbuddyMcpConnection[]
}

model WorkbuddyMcpConnection {
  id                 String    @id @default(cuid())
  tenantId           String
  userId             String
  agentId            String
  label              String
  tokenHash          String    @unique
  tokenPrefix        String
  status             String    @default("active")
  productCode        String?
  operatingEntityId  String?
  scopes             Json?
  expiresAt          DateTime?
  revokedAt          DateTime?
  rotatedFromId      String?
  rateLimitPerMinute Int       @default(30)
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent  AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@index([agentId, status])
  @@index([tenantId, productCode, status])
  @@index([rotatedFromId])
}

model BillingAccessToken {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  label          String?
  tokenHash      String    @unique
  tokenPrefix    String
  status         String    @default("active")
  expiresAt      DateTime?
  revokedAt      DateTime?
  rotatedFromId  String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingConsumes BillingConsume[]

  @@index([tenantId, userId, status])
  @@index([rotatedFromId])
}

model BillingConsume {
  id                String    @id @default(cuid())
  tenantId          String
  userId            String?
  accessTokenId     String?
  requestId         String
  amount            Int
  status            String    @default("completed")
  creditTransactionId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accessToken BillingAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)

  @@unique([accessTokenId, requestId])
  @@index([tenantId, createdAt])
  @@index([accessTokenId, status, createdAt])
}

model SkillRelease {
  id              String             @id @default(cuid())
  skillId         String
  version         String
  fileHash        String
  status          SkillReleaseStatus @default(draft)
  rollbackVersion String?
  packageSnapshot Json?
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  bindings     AgentSkillBinding[]
  capabilities AgentCapability[]

  @@unique([skillId, version])
  @@index([skillId, status])
}

model AgentSkillBinding {
  id             String   @id @default(cuid())
  agentId        String
  skillReleaseId String
  isDefault      Boolean  @default(false)
  routingHints   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent        AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillRelease SkillRelease    @relation(fields: [skillReleaseId], references: [id])

  @@unique([agentId, skillReleaseId])
  @@index([agentId, isDefault])
}

model AgentCapability {
  id             String   @id @default(cuid())
  agentId        String
  key            String
  title          String
  subtitle       String
  promptTemplate String?
  skillReleaseId String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent        AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillRelease SkillRelease    @relation(fields: [skillReleaseId], references: [id])

  @@unique([agentId, key])
  @@index([agentId, sortOrder])
}

model TenantAgentEntitlement {
  id        String                 @id @default(cuid())
  tenantId  String
