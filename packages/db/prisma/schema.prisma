enum MarketplaceSkuStatus {
  selling
  trial
  internal
  coming_soon
  offline
}

enum MarketplaceSupplierType {
  self_operated
  third_party
}

enum MarketplaceEntitlementTrack {
  ppu
  subscription
}

enum MarketplaceEntitlementStatus {
  active
  expired
  canceled
}

enum MarketplaceLedgerType {
  topup
  ppu_consume
  ppu_refund
  subscription_charge
  subscription_refund
  adjustment
}

enum MarketplaceOrderStatus {
