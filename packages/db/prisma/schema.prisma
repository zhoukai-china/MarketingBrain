/// 已付费交付物（2026-09-16，用户拍板：**服务端保留 7 天**）。
///
/// 背景（汽配信息网现场）：客户退出/换手机后，报告正文与他填写的需求原本只存在于他自己的页面上，
/// 丢了就只能退款——我们连"他当时填了什么、输出了什么"都查不到。
/// 现在把「已成功交付并扣费」的输入与产出在服务端**留 7 天**：
/// 客户重新打开同一智能体可自动找回；我们也能在他求助时定位问题。
/// 7 天后由读取路径顺带清理（`expiresAt`），不长期占用空间。
model MarketplaceDeliverable {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  skuCode   String
  skuName   String?
  /// 客户填写的需求单（前端拼好的那段文本，不含任何凭据）。
  input     String
  /// 交付正文（Markdown 原文）。
  answer    String
  credits   Int      @default(0)
  requestId String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([tenantId, userId, createdAt])
  @@index([userId, skuCode, createdAt])
  @@index([expiresAt])
}

model MarketplaceLedgerEntry {
  id              String                @id @default(cuid())
  tenantId        String
  userId          String?
  skuId           String?
  type            MarketplaceLedgerType
  direction       String
  amountCredits   Int                   @default(0)
  amountCny       Int                   @default(0)
  status          String                @default("completed")
  idempotencyKey  String?
  refType         String?
  refId           String?
  metadata        Json?
  createdAt       DateTime              @default(now())

  sku MarketplaceSku? @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([type, createdAt])
  @@index([skuId, createdAt])
}

// ══════════════════════════════════════════════════════
// 模块五：思潼AI 统一钱包（v5 双桶账本 · 账号级）
// paid = 基础积分（充值 base，严格 price×20）；bonus = 阶梯赠送（独立记账，不退）。
// 消耗顺序先 paid 后 bonus；跨桶拆两条 ledger；同一 request_id 幂等。
// ══════════════════════════════════════════════════════

enum WalletBucket {
  paid
  bonus
}

enum WalletLedgerType {
  recharge
  bonus
  consume
  refund
  admin
  redo
}

enum RechargeOrderStatus {
  created
  paid
  failed
  refunded
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  paidBalance  Int      @default(0)
  bonusBalance Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgers WalletLedger[]
}

model WalletLedger {
  id           String            @id @default(cuid())
  walletId     String
  userId       String
  delta        Int
  bucket       WalletBucket
  type         WalletLedgerType
  refOrderId   String?
  refRequestId String?
  skillId      String?
  viaBundle    String?
  stepIndex    Int?
  priceVersion Int?
  source       String            @default("web")
  expiresAt DateTime?
  createdAt    DateTime          @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, type, createdAt])
  @@index([walletId, refRequestId, createdAt])
}

model RechargeOrder {
  id             String              @id @default(cuid())
  userId         String
  planId         String?
  amountCny      Int
  basePts        Int
  bonusPts       Int
  method         String              @default("wechat")
  status         RechargeOrderStatus @default(created)
  idempotencyKey String?             @unique
  priceVersion   Int?
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

